# Defaults for this repo. Shows the "illustrative data" banner in the
# sidebar by default — this matters because the CSVs committed to public/
# are synthetic (see scripts/generate_synthetic_data.py), not the marae's
# real energy-use readings, and the published GitHub Pages site should
# never look like it's showing real telemetry.
#
# If you're running this locally against the REAL data pipeline (see
# README "Regenerating the CSVs") for genuine internal Trust analysis,
# create a .env.local (already gitignored, won't be committed) with:
#   VITE_ILLUSTRATIVE_DATA=false
VITE_ILLUSTRATIVE_DATA=true
